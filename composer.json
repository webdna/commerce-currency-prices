{
  "name": "webdna/commerce-currency-prices",
  "description": "Sell from one Craft Commerce store in several currencies, at prices you set for each currency rather than prices converted by an exchange rate.",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "commerce",
    "craft-commerce",
    "currency prices",
    "multi-currency",
    "payment currencies"
  ],
  "support": {
    "issues": "https://github.com/webdna/commerce-currency-prices/issues",
    "source": "https://github.com/webdna/commerce-currency-prices",
    "docs": "https://github.com/webdna/commerce-currency-prices/blob/master/README.md"
  },
  "license": "proprietary",
  "authors": [
    {
      "name": "webdna",
      "homepage": "https://webdna.co.uk"
    }
  ],
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.3"
  },
  "require-dev": {
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.0",
    "codeception/module-yii2": "^1.1",
    "craftcms/digital-products": "^4.1",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1",
    "verbb/events": "^3.1",
    "vlucas/phpdotenv": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "webdna\\commerce\\currencyprices\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "webdna\\commerce\\currencyprices\\tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@cs",
      "@analyse",
      "@test"
    ],
    "cs": "ecs check --ansi",
    "cs-fix": "ecs check --ansi --fix",
    "analyse": [
      "codecept build --quiet",
      "phpstan analyse --memory-limit=1G --no-progress"
    ],
    "test": "codecept run"
  },
  "extra": {
    "name": "Commerce Currency Prices",
    "handle": "commerce-currency-prices",
    "class": "webdna\\commerce\\currencyprices\\CurrencyPrices",
    "developer": "webdna",
    "developerUrl": "https://webdna.co.uk",
    "documentationUrl": "https://github.com/webdna/commerce-currency-prices/blob/master/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/webdna/commerce-currency-prices/master/CHANGELOG.md"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "php-http/discovery": false,
      "yiisoft/yii2-composer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
