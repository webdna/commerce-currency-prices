includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 5
    # src/ joins in task 0.2: until then it is the 3.x Craft 4 code, which cannot analyse against
    # Craft 5 and is being deleted rather than fixed.
    paths:
        - tests
    excludePaths:
        - tests/_craft/storage
        # Codeception writes both and .gitignore drops them, so a fresh checkout has neither.
        - tests/_output (?)
        - tests/Support/_generated (?)
